# Local development
NODE_ENV=development
LOG_LEVEL=info
TRADING_MODE=paper

# Optional app settings
# NOVA_PORT=7411

# Optional PostgreSQL persistence
# POSTGRES_URL=<SET_IN_HOST_SECRET_MANAGER>
# TRADING_NOVA_DB_SCHEMA=public

# Required for hosted / production mode
# NOVA_ACCESS_PASSWORD=<SET_IN_HOST_SECRET_MANAGER>
# NOVA_SESSION_SECRET=<SET_IN_HOST_SECRET_MANAGER>

# Optional AI config used by research modules
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_WEB_RESEARCH=true
