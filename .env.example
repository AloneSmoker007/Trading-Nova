# Local development
NODE_ENV=development
LOG_LEVEL=info
TRADING_MODE=paper

# Optional app settings
# NOVA_PORT=7411

# Optional PostgreSQL persistence
# POSTGRES_URL=postgres://user:password@localhost:5432/trading_nova
# TRADING_NOVA_DB_SCHEMA=public

# Required for hosted / production mode
# NOVA_ACCESS_PASSWORD=replace-with-a-strong-password-at-least-12-characters
# NOVA_SESSION_SECRET=replace-with-a-32-byte-or-longer-random-secret

# Optional AI config used by research modules
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_WEB_RESEARCH=true
